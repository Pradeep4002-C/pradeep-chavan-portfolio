{
  "name": "pradeep-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Pradeep Chavan's portfolio: React frontend and Express API",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "dev:server": "npm --prefix backend run dev",
    "start": "npm --prefix backend run start",
    "start:server": "npm --prefix backend run start",
    "seed:content": "node backend/scripts/seed-content.js",
    "admin:create": "node backend/scripts/create-admin.js",
    "admin:unlock": "node backend/src/scripts/unlockAdmin.js",
    "test:server": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:server && npm run test:frontend",
    "install:all": "npm --prefix frontend ci --include=dev && npm --prefix backend ci"
  }
}
