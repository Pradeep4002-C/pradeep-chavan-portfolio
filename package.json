{
  "name": "pradeep-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Pradeep Chavan's portfolio: React frontend and Express API",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "preview:frontend": "npm --prefix frontend run preview",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server run start",
    "seed:content": "node server/scripts/seed-content.js",
    "admin:create": "node server/scripts/create-admin.js",
    "install:all": "npm --prefix frontend ci && npm --prefix server ci"
  }
}
