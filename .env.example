# ---------------------------------------------------------------------------
# Pradeep Chavan portfolio — environment configuration
#
# Copy this file to `.env` in the repository root, then replace the values.
# `.env` is ignored by Git; this example file is safe to commit.
# The server reads this file regardless of which directory you start it from.
# ---------------------------------------------------------------------------

# Runtime: development | production | test
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# Set to true only when the API is behind exactly one trusted reverse proxy
# (for example Render). This lets the contact rate limiter see the visitor IP.
# Leave false when the API is directly exposed to the internet.
TRUST_PROXY=false

# MongoDB connection string.
# This default points at a local MongoDB and contains no credentials.
# Replace it with your own local or Atlas URI and never commit the result.
MONGODB_URI=mongodb://127.0.0.1:27017/pradeep_portfolio

# Secret used to sign the administrator session cookie. Required; the server
# refuses to start without it. Use at least 32 random bytes, for example:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64'))"
# Never commit the real value.
SESSION_SECRET=replace-with-a-random-32-byte-value

# Optional trusted browser origin for the Vite dev server. Development
# defaults to http://localhost:5173. Production normally relies on same-origin
# validation, so leave this empty unless the frontend is served from a
# different origin.
# CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas example — replace every <placeholder>:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
