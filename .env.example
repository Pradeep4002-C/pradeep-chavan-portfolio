# ---------------------------------------------------------------------------
# Pradeep Chavan portfolio — environment configuration
#
# Copy this file to `.env` in the repository root, then replace the values.
# `.env` is ignored by Git; this example file is safe to commit.
# The server reads this file regardless of which directory you start it from.
# ---------------------------------------------------------------------------

# Runtime: development | production | test
NODE_ENV=development

# Port the Express API listens on.
PORT=4000

# MongoDB connection string.
# This default points at a local MongoDB and contains no credentials.
# Replace it with your own local or Atlas URI and never commit the result.
MONGODB_URI=mongodb://127.0.0.1:27017/pradeep_portfolio

# MongoDB Atlas example — replace every <placeholder>:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
